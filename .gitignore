# .NET build output
bin/
obj/
*.user
*.suo

# Fable / Vite (reserved — no Fable client in v0, but the directories
# follow the workspace convention so an interactive-island upgrade is
# friction-free).
output/
.vite/
dist/

# Tailwind output (compiled CSS lives under src/Server/wwwroot/css/ and
# is regenerated by the Tailwind CLI; do not commit).
src/Server/wwwroot/css/site.css
src/Server/wwwroot/css/site.css.map

# pagefind output (Stage 5 — search index is build artefact, not source).
src/Server/wwwroot/pagefind/

# Synced docs (Stage 4 — content/docs/ is copied from ../toolup-forge/docs/
# at build time, never edited in this repo).
content/docs/

# Runtime data — the SDK default IEntityStore / IBlobStorage / file-secret-
# store all root here on first request when no cloud companion is wired.
# Recreated on next boot; never source.
data/

# Farmer's working directory — ARM-template intermediate output; not source.
.farmer/

# Local publish output + deploy bundle — produced by Bundle / Deploy targets.
publish/
bundle.zip

# Launcher artefacts — durable PID file + redirected stdout / stderr logs
# of the background server process. Recreated on every launch.
.toolup-forge-io-pids
toolup-forge-io-server.log
toolup-forge-io-server.log.err
*.log.locked-*

# Node
node_modules/

# Local secrets / env
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# IDE
.vs/
.idea/
*.swp
