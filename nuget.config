<?xml version="1.0" encoding="utf-8"?>
<!--
  toolup-forge-io consumes the ToolUp.* SDK packages from the public
  toolup-forge GitHub Packages NuGet feed. Three sources, in declaration
  order:

  - `nuget.org` — upstream public mirror (third-party deps: Giraffe,
    Markdig, etc.).
  - `local` (`../local-nuget-feed`) — workspace-shared local feed for
    cross-repo iteration. When the SDK author re-packs forge into this
    feed (`dotnet run :: Pack` from forge), a fresh restore here picks
    up the new bits immediately without a publish-then-bump cycle. The
    local source stays higher-priority than `cloud` so iteration loops
    are friction-free. Forward slash for Linux CI portability.
  - `cloud` — the toolup-forge GitHub Packages NuGet feed. Resolves any
    ToolUp.* version not present in the local feed (every steady-state
    release). The packages themselves are public, but GitHub Packages
    NuGet still requires a token for restore (a long-standing GH Packages
    quirk specific to NuGet). Credentials reference env vars
    GITHUB_PACKAGES_USER + GITHUB_PACKAGES_TOKEN so no secret lives in
    source — set them in your shell profile or .env.local. CI uses the
    Actions-provided GITHUB_TOKEN with `permissions: packages: read`.

    PAT scope required: `read:packages`. Any GitHub username works.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="../local-nuget-feed" />
    <add key="cloud" value="https://nuget.pkg.github.com/ToolUp-Forge/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- CPM with multiple sources requires explicit mapping (NU1507).
         Longest-prefix-match: third-party deps from nuget.org; ToolUp.*
         from local first (iteration override) then cloud (steady state). -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="ToolUp.*" />
    </packageSource>
    <packageSource key="cloud">
      <package pattern="ToolUp.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <cloud>
      <add key="Username" value="%GITHUB_PACKAGES_USER%" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </cloud>
  </packageSourceCredentials>
</configuration>
